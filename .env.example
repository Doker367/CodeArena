# ---------- Backend (Express) ----------
PORT=4000
# Origen permitido para CORS si consumes la API directamente
FRONTEND_ORIGIN=http://localhost:3100
# Directorio de la base SQLite (default: backend/data)
# DATA_DIR=/ruta/absoluta/data
# Cookies Secure (solo HTTPS en producción)
COOKIE_SECURE=false

# ---------- Frontend (Next.js) ----------
# URL interna del backend usada por SSR y por el proxy /api/*
API_INTERNAL_URL=http://127.0.0.1:4000

# ---------- Traducción de lenguas originarias ----------
# Servicio local MADLAD-400 (recomendado, ver translation-service/README.md)
# npm run translate:setup && npm run translate
TRANSLATE_SERVICE_URL=http://127.0.0.1:5001
# Ruta del modelo CTranslate2 (default: translation-service/models/madlad400-3b-ct2-int8)
# MODEL_DIR=/ruta/al/modelo
# En 2026 no hay API pública confiable para tsotsil/tseltal/ch'ol.
# Opcional: habilita el modelo experimental tsotsil→español de Hugging Face.
# TRANSLATE_PROVIDER=hf
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxx
# HF_TRANSLATION_MODEL=Joseph18/tsotsil-es-translator
# Red de intérpretes mostrada en /lenguas
INTERPRETER_PHONE=8002442727
INTERPRETER_WHATSAPP=529671234567
